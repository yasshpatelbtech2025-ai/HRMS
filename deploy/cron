# /etc/cron.d/srympex
# Laravel's scheduler (daily compliance tasks, 30-day cleanup) every minute, and the nightly backup at 01:30.
* * * * * srympex cd /var/www/srympex && php artisan schedule:run >> /dev/null 2>&1
30 1 * * * root /var/www/srympex/deploy/backup.sh >> /var/log/srympex-backup.log 2>&1
